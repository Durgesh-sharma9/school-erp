datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. School Information
model School {
  id              String            @id @default(uuid())
  schoolName      String            @default("J D International School")
  schoolCode      String?           @default("10964")
  udiseNo         String?           @default("08121204312")
  affiliationNo   String?           @default("1730619")
  address         String?
  place           String?           @default("Jaipur")
  pinCode         String?           @default("302026")
  phone1          String?           @default("8947919195")
  phone2          String?
  email           String?           @default("10964@cbseshiksha.in")
  website         String?           @default("www.jdschooljaipur.com")
  logoUrl         String?
  receiptNotes    String?
  extraData       Json?             @default("{}")

  sessions        AcademicSession[]
  classes         Class[]
  students        Student[]
  staff           Staff[]
  feeHeads        FeeHead[]
  feeStructures   FeeStructure[]
  feeReceipts     FeeReceipt[]
  exams           Exam[]
  users           User[]
  timetables      Timetable[]
  rooms           Room[]
  dailyReports    DailyReport[]
  lessonPlans     LessonPlan[]
  homeworks       TimetableHomework[]
  replacementAssignments ReplacementAssignment[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model AcademicSession {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionName     String            // e.g. "2026-2027"
  isCurrent       Boolean           @default(true)

  classes         Class[]
  students        Student[]
  feeReceipts     FeeReceipt[]
  exams           Exam[]

  createdAt       DateTime          @default(now())
}

// 2. Class & Section
model Class {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId       String
  session         AcademicSession   @relation(fields: [sessionId], references: [id])
  className       String            // e.g. "Class 10", "Nursery"
  priority        Int               @default(1)

  sections        Section[]
  subjects        Subject[]
  students        Student[]
  feeStructures   FeeStructure[]

  createdAt       DateTime          @default(now())
}

model Section {
  id              String            @id @default(uuid())
  classId         String
  class           Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionName     String            // "A", "B", "C"

  students        Student[]
  attendance      StudentAttendance[]

  createdAt       DateTime          @default(now())
}

model Subject {
  id              String            @id @default(uuid())
  classId         String
  class           Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectName     String            // English, Hindi, Math
  subjectCode     String?

  markEntries     MarkEntry[]
  createdAt       DateTime          @default(now())
}

// 3. Student (Matching all UAB Registration Form Tabs)
model Student {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId       String
  session         AcademicSession   @relation(fields: [sessionId], references: [id])
  classId         String
  class           Class             @relation(fields: [classId], references: [id])
  sectionId       String
  section         Section           @relation(fields: [sectionId], references: [id])

  // Student Details Tab
  srNo            String?
  admNo           String
  enrollNo        String?
  permanentEduNo  String?
  admDate         DateTime          @default(now())
  dob             DateTime?
  studentType     String            @default("OLD") // NEW, OLD
  stream          String?
  firstName       String
  lastName        String?
  gender          String            @default("Boy") // Boy, Girl
  photoUrl        String?

  // Contact & Parent Details Tab
  contactName     String?
  contactNoSms    String?
  fatherName      String
  motherName      String?
  fatherMobile    String?
  motherMobile    String?
  address         String?

  // Financial & Academic Relations
  attendance      StudentAttendance[]
  feeLedger       StudentFeeLedger?
  receipts        FeeReceipt[]
  markEntries     MarkEntry[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([schoolId, admNo])
}

// 4. Attendance (One-tap class attendance)
model StudentAttendance {
  id              String            @id @default(uuid())
  studentId       String
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId       String
  section         Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date            DateTime          @db.Date
  status          String            @default("P") // P (Present), A (Absent), L (Leave)

  @@unique([studentId, date])
}

// 5. Fee Management (Matching UAB Counter POS)
model FeeHead {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  headName        String            // Tuition, Transport, Exam, Admission

  items           FeeStructureItem[]
  createdAt       DateTime          @default(now())
}

model FeeStructure {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId         String
  class           Class             @relation(fields: [classId], references: [id])
  stream          String?
  structureType   String            @default("Annual")

  items           FeeStructureItem[]
  createdAt       DateTime          @default(now())
}

model FeeStructureItem {
  id              String            @id @default(uuid())
  structureId     String
  structure       FeeStructure      @relation(fields: [structureId], references: [id], onDelete: Cascade)
  feeHeadId       String
  feeHead         FeeHead           @relation(fields: [feeHeadId], references: [id])
  amount          Float
}

model StudentFeeLedger {
  id              String            @id @default(uuid())
  studentId       String            @unique
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalDue        Float             @default(0)
  totalPaid       Float             @default(0)
  totalDiscount   Float             @default(0)
  balanceDue      Float             @default(0)

  updatedAt       DateTime          @updatedAt
}

model FeeReceipt {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId       String
  session         AcademicSession   @relation(fields: [sessionId], references: [id])
  studentId       String
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receiptNo       String
  receiptDate     DateTime          @default(now())
  payMode         String            @default("Cash") // Cash, UPI, Cheque, Bank
  totalAmount     Float
  discount        Float             @default(0)
  payableAmount   Float
  paidAmount      Float
  dueAmount       Float             @default(0)
  remarks         String?
  collectedBy     String            @default("Admin")

  createdAt       DateTime          @default(now())

  @@unique([schoolId, receiptNo])
}

// 6. Examination & Marksheet
model Exam {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId       String
  session         AcademicSession   @relation(fields: [sessionId], references: [id])
  examName        String            // Unit Test 1, Half Yearly, Annual Exam
  term            String            @default("Term 1")

  markEntries     MarkEntry[]
  createdAt       DateTime          @default(now())
}

model MarkEntry {
  id              String            @id @default(uuid())
  examId          String
  exam            Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  maxMarks        Float             @default(100)
  marksObtained   Float
  grade           String?

  @@unique([examId, studentId, subjectId])
}

// 7. Staff & User Authentication
model Staff {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employeeCode    String
  name            String
  mobile          String
  email           String?
  designation     String            // Teacher, Principal, Accountant
  department      String?
  joiningDate     DateTime          @default(now())
  salary          Float             @default(0)

  createdAt       DateTime          @default(now())

  @@unique([schoolId, employeeCode])
}

model User {
  id              String            @id @default(uuid())
  schoolId        String?
  school          School?           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  username        String            // e.g. "8947919195"
  password        String            // Hashed bcrypt
  role            String            @default("ADMIN") // SUPER_ADMIN, ADMIN, STAFF, STUDENT
  name            String            @default("Admin")
  isActive        Boolean           @default(true)

  createdAt       DateTime          @default(now())

  @@unique([schoolId, username])
}


// =================================================================
// 8. Timetable Pro Suite Modules
// =================================================================

model Timetable {
  id             String          @id @default(uuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  status         String          @default("DRAFT") // DRAFT, PUBLISHED
  baseStartTime  String          @default("08:00")
  periodDuration Int             @default(45)
  workingDays    Json?           @default("[1,2,3,4,5,6]")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  slots          TimetableSlot[]
  periods        Period[]

  @@index([schoolId])
}

model Period {
  id             String          @id @default(uuid())
  schoolId       String
  timetableId    String?
  timetable      Timetable?      @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  periodNumber   Int
  startTime      String
  endTime        String
  isBreak        Boolean         @default(false)
  label          String?

  slots          TimetableSlot[]
  replacements   ReplacementAssignment[]

  @@index([schoolId])
  @@index([timetableId])
}

model Room {
  id             String          @id @default(uuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roomNumber     String
  floor          String?
  block          String?
  capacity       Int?            @default(40)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  slots          TimetableSlot[]

  @@index([schoolId])
}

model TimetableSlot {
  id          String                 @id @default(uuid())
  timetableId String
  timetable   Timetable              @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  schoolId    String
  dayOfWeek   Int                    // 1=Mon, 2=Tue, ..., 6=Sat
  periodId    String
  period      Period                 @relation(fields: [periodId], references: [id], onDelete: Cascade)
  classId     String
  subjectId   String
  teacherId   String
  roomId      String?
  room        Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  replacements ReplacementAssignment[]
  lessonPlans  LessonPlan[]

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([timetableId, dayOfWeek, periodId, classId])
  @@index([timetableId])
  @@index([schoolId])
}

model TeacherAttendanceRecord {
  id        String                 @id @default(uuid())
  schoolId  String
  teacherId String
  date      String                 // YYYY-MM-DD
  status    String                 @default("PRESENT") // PRESENT, ABSENT, FIRST_HALF, SECOND_HALF
  reason    String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([schoolId, teacherId, date])
  @@index([schoolId, date])
}

model ReplacementAssignment {
  id                   String      @id @default(uuid())
  schoolId             String
  school               School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date                 String      // YYYY-MM-DD
  periodId             String
  period               Period      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  classId              String
  originalTeacherId    String
  replacementTeacherId String
  reason               String      @default("Casual Leave")
  status               String      @default("Assigned") // Pending, Assigned, Completed, Cancelled
  slotId               String?
  slot                 TimetableSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([schoolId, date])
}

model DailyReport {
  id          String             @id @default(uuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId   String
  reportDate  String             // YYYY-MM-DD
  status      String             @default("DRAFT") // DRAFT, SUBMITTED
  submittedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  entries     DailyReportEntry[]

  @@unique([schoolId, teacherId, reportDate])
  @@index([schoolId, reportDate])
}

model DailyReportEntry {
  id                  String       @id @default(uuid())
  reportId            String
  report              DailyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  classId             String
  subjectId           String
  description         String
  isCompleted         Boolean      @default(false)
  isProxy             Boolean      @default(false)
  entryType           String       @default("LESSON") // LESSON, ACTIVITY
  activityCategory    String?
  activityDescription String?
  learningOutcome     String?
  createdAt           DateTime     @default(now())

  @@index([reportId])
}

model TimetableHomework {
  id          String             @id @default(uuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId   String
  classId     String
  title       String
  description String
  status      String             @default("SENT_TO_ADMIN") // DRAFT, SENT_TO_ADMIN
  dueDate     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([schoolId, classId])
}

model LessonPlan {
  id                String              @id @default(uuid())
  schoolId          String
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId         String
  slotId            String?
  slot              TimetableSlot?      @relation(fields: [slotId], references: [id], onDelete: SetNull)
  classId           String
  subjectId         String
  periodId          String?
  planDate          String              // YYYY-MM-DD
  lessonTitle       String
  topic             String?
  chapter           String?
  subtopic          String?
  teachingAids      String?
  activities        String?
  homework          String?
  assessmentMethod  String?
  learningOutcomes  String?
  notes             String?
  estimatedDuration Int?                @default(45)
  status            String              @default("PLANNED") // DRAFT, PLANNED, COMPLETED, SKIPPED, CANCELLED

  attachments       LessonAttachment[]
  comments          LessonPlanComment[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([schoolId, planDate])
  @@index([schoolId, teacherId])
}

model LessonAttachment {
  id           String             @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan         @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  createdAt    DateTime           @default(now())

  @@index([lessonPlanId])
}

model LessonPlanComment {
  id           String             @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan         @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  userId       String
  authorName   String?            @default("Admin")
  content      String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([lessonPlanId])
}
