# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolerp?schema=public"

# Authentication Secrets
JWT_SECRET="school_erp_super_secret_jwt_key_2026_webncode"
JWT_EXPIRES_IN="7d"

# Client CORS URL
CLIENT_URL="http://localhost:5173"

# =================================================================
# 📸 IMAGEKIT CONFIGURATION (Student Photos, School Logos, Docs)
# =================================================================
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# =================================================================
# 📧 SMTP EMAIL CONFIGURATION (Admission, Fees, Password Reset)
# =================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
MAIL_FROM='"School ERP" <noreply@schoolerp.in>'

# =================================================================
# 💬 WHATSAPP CLOUD API (Absent Alerts, Fee Reminders, Results)
# =================================================================
WHATSAPP_ACCESS_TOKEN="your_whatsapp_meta_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
